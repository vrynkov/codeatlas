# Copy this file to ".env" and paste your key. NEVER commit .env to GitHub.
GROQ_API_KEY=your_key_here
# Optional: change the model if Groq retires this one (see console.groq.com/docs/models)
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional: override the automatic model fallback order (default: GROQ_MODEL, then the other
# two gpt-oss/qwen models). Comma-separated, tried left to right when one runs out for the day.
# GROQ_MODEL_CHAIN=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b

# Optional: logging and tracing (see "Logging and tracing" in the README)
# LOG_FORMAT=json            # default on your laptop: readable text. json = the exact cloud format
# LOG_LEVEL=DEBUG
# LANGSMITH_TRACING=true     # free key at smith.langchain.com; LangGraph then traces every question
# LANGSMITH_API_KEY=your_langsmith_key
# LANGSMITH_PROJECT=codeatlas-local
